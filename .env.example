# Telegram Bot (get this from @BotFather on Telegram — see Phase 4)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Threat intelligence feed credentials (Phase 6)
THREATFOX_AUTH_KEY=your_threatfox_authkey_here
CHAINABUSE_API_KEY=your_chainabuse_api_key_here
# Threat Intel / Market Data API keys
DATABASE_URL=sqlite:///data/platform.db
# Environment mode: development | staging | production
ENVIRONMENT=development
# Solana forensics (Phase 9.2) — get key at https://dashboard.helius.dev
HELIUS_API_KEY=your_helius_api_key_here
# Network security tools (Phase 9.3)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
# Active scanning authorization (Phase 9.4)
SCAN_AUTHORIZED_USERS=7094450571

#AI analysis (phase 11) — provider selection (Phase 10 architecture)
# AI_PROVIDER selects which class provider_factory.py instantiates.
# Currently active on this deployment: openrouter (see analysis/providers/provider_factory.py
# for the full supported list: openai, gemini, deepseek, anthropic, local, groq,
# cerebras, together, fireworks, openrouter, nvidia_nim, ollama, vllm, omniroute).
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenRouter cost/reliability ceilings (Phase 12 hardening).
# MAX_TOKENS caps the maximum tokens billed per AI analysis call.
# TIMEOUT_SECONDS caps how long a hung request waits before failing cleanly.
# Both are optional — safe defaults (1000 / 30.0) apply if unset.
OPENROUTER_MAX_TOKENS=1000
OPENROUTER_TIMEOUT_SECONDS=30.0

# GROQ_API_KEY — kept for reference; not the currently active AI_PROVIDER,
# but supported if you switch back (see mapping in provider_factory.py).
GROQ_API_KEY=your_groq_api_key_here
